# 复制为 .env 后填入真实值；.env 不要提交到 git
OPENROUTER_API_KEY=

# 端口
PORT=8788

# 部署后的公开地址，会作为 OpenRouter 的 HTTP-Referer 上报
PUBLIC_URL=http://localhost:8788

# 限流：每 IP 每窗口最多请求数 / 窗口秒数
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=600

# 单次请求体上限（图片 base64 会比较大）
MAX_BODY_MB=12

# 没有 Key 时是否自动进入演示模式（本地联调用；线上建议保持 0）
ALLOW_NO_KEY=0
